              "id": "byName",
              "options": "Other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#4A7FD0",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "de-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Total\",\n       count(*) FILTER (WHERE ua.username IS NOT NULL) AS \"University of Arizona\",\n       count(*) FILTER (WHERE ua.username IS NULL) AS \"Other\"\n  FROM logins l\n  JOIN users u ON u.id = l.user_id\n  LEFT JOIN grafana.ua_users ua ON ua.username = u.username\n WHERE $__timeFilter(l.login_time AT TIME ZONE 'UTC')",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ]
          }
        }
      ],
      "title": "Logins",
      "type": "stat"
    },
