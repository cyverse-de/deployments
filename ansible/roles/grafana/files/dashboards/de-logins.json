          "rawSql": "SELECT count(DISTINCT l.user_id) AS \"Total\",\n       count(DISTINCT l.user_id) FILTER (WHERE ua.username IS NOT NULL) AS \"University of Arizona\",\n       count(DISTINCT l.user_id) FILTER (WHERE ua.username IS NULL) AS \"Other\"\n  FROM logins l\n  JOIN users u ON u.id = l.user_id\n  LEFT JOIN grafana.ua_users ua ON ua.username = u.username\n WHERE $__timeFilter(l.login_time AT TIME ZONE 'UTC')",
