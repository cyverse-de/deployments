apiVersion: apps/v1
kind: Deployment
metadata:
  name: resource-usage-api
spec:
  replicas: {{ resource_usage_api_replicas }}
  selector:
    matchLabels:
      de-app: resource-usage-api
  template:
    metadata:
      labels:
        de-app: resource-usage-api
        app: de
    spec:
      serviceAccount: configurator
{% if resource_usage_api_pod_anti_affinity %}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: de-app
                    operator: In
                    values:
                      - resource-usage-api
              topologyKey: kubernetes.io/hostname
{% endif %}
      restartPolicy: Always
      # A data usage batch can hold the ICAT database for several minutes, and the
      # service drains in-flight work on SIGTERM rather than abandoning it partway.
      terminationGracePeriodSeconds: {{ resource_usage_api_termination_grace_period }}
      volumes:
{% include 'partials/de_ca_volume.j2' %}
        - name: resource-usage-api-configs
          secret:
            secretName: resource-usage-api-configs
            items:
              - key: jobservices.yml
                path: service.yml
      containers:
        - name: resource-usage-api
          image: harbor.cyverse.org/de/resource-usage-api
          resources:
            requests:
              cpu: "1m"
              memory: "128Mi"
              ephemeral-storage: "1Gi"
            # The pod now holds two database pools and runs the data usage batches
            # alongside the latency-sensitive summary endpoint, so the old 100m
            # ceiling would throttle requests behind a batch. Measure before
            # trimming these back.
            limits:
              cpu: "500m"
              memory: "512Mi"
              ephemeral-storage: "1Gi"
          env:
{% include 'partials/de_ca_env.j2' %}
            - name: TZ
              valueFrom:
                configMapKeyRef:
                  name: timezone
                  key: timezone
          args:
            - --log-level
            - debug
            - --subscriptions-base-uri
            - {{ baseurls_subscriptions }}
          ports:
            - name: listen-port
              containerPort: 60000
          volumeMounts:
{% include 'partials/de_ca_volume_mount.j2' %}
            - name: resource-usage-api-configs
              mountPath: /etc/cyverse/de/configs
              readOnly: true
          livenessProbe:
            httpGet:
              path: /
              port: 60000
            initialDelaySeconds: 5
            periodSeconds: 5
          readinessProbe:
            httpGet:
              path: /
              port: 60000
            initialDelaySeconds: 5
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: resource-usage-api
spec:
  selector:
    de-app: resource-usage-api
  ports:
    - protocol: TCP
      port: 80
      targetPort: listen-port
