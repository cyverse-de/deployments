apiVersion: apps/v1
kind: Deployment
metadata:
  name: vice-status-listener
spec:
  replicas: {{ vice_status_listener_replicas }}
  selector:
    matchLabels:
      de-app: vice-status-listener
  template:
    metadata:
      labels:
        de-app: vice-status-listener
        app: de
    spec:
      serviceAccountName: app-exposer
{% if vice_status_listener_pod_anti_affinity %}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: de-app
                    operator: In
                    values:
                      - vice-status-listener
              topologyKey: kubernetes.io/hostname
{% endif %}
      restartPolicy: Always
      volumes:
{% if de_ca_bundle_configmap | default('', true) | length > 0 %}
        - name: de-ca
          configMap:
            name: {{ de_ca_bundle_configmap }}
{% endif %}
        - name: vice-status-listener-configs
          secret:
            secretName: vice-status-listener-configs
            items:
              - key: jobservices.yml
                path: jobservices.yml
      containers:
        - name: vice-status-listener
          image: harbor.cyverse.org/de/vice-status-listener
          resources:
            requests:
              cpu: "1m"
              memory: "128Mi"
              ephemeral-storage: "1Gi"
            limits:
              cpu: "100m"
              memory: "256Mi"
              ephemeral-storage: "1Gi"
          args:
            - --namespace
            - "$(VSL_NAMESPACE)"
            - --log-level
            - debug
          env:
{% if de_ca_bundle_configmap | default('', true) | length > 0 %}
            # One variable per runtime, because each ignores the others':
            # SSL_CERT_FILE is OpenSSL and so covers Go, Node reads only
            # NODE_EXTRA_CA_CERTS, and python-requests only REQUESTS_CA_BUNDLE.
            - name: SSL_CERT_FILE
              value: {{ de_ca_bundle_mount_path }}/{{ de_ca_bundle_key }}
            - name: NODE_EXTRA_CA_CERTS
              value: {{ de_ca_bundle_mount_path }}/{{ de_ca_bundle_key }}
            - name: REQUESTS_CA_BUNDLE
              value: {{ de_ca_bundle_mount_path }}/{{ de_ca_bundle_key }}
{% endif %}
            - name: TZ
              valueFrom:
                configMapKeyRef:
                  name: timezone
                  key: timezone
            - name: VSL_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: CLUSTER
              value: "1"
          volumeMounts:
{% if de_ca_bundle_configmap | default('', true) | length > 0 %}
            - name: de-ca
              mountPath: {{ de_ca_bundle_mount_path }}
              readOnly: true
{% endif %}
            - name: vice-status-listener-configs
              mountPath: /etc/iplant/de
              readOnly: true
