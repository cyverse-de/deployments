apiVersion: apps/v1
kind: Deployment
metadata:
  name: event-recorder
spec:
  replicas: {{ event_recorder_replicas }}
  selector:
    matchLabels:
      de-app: event-recorder
  template:
    metadata:
      labels:
        de-app: event-recorder
    spec:
      restartPolicy: Always
      volumes:
{% include 'partials/de_ca_volume.j2' %}
        - name: event-recorder-configs
          secret:
            secretName: event-recorder-configs
            items:
              - key: jobservices.yml
                path: jobservices.yml
      containers:
        - name: event-recorder
          image: harbor.cyverse.org/de/event-recorder
          resources:
            requests:
              cpu: "1m"
              memory: "128Mi"
              ephemeral-storage: "1Gi"
            limits:
              cpu: "100m"
              memory: "256Mi"
              ephemeral-storage: "1Gi"
          args:
            - --config
            - /etc/iplant/de/jobservices.yml
          env:
{% include 'partials/de_ca_env.j2' %}
            - name: TZ
              valueFrom:
                configMapKeyRef:
                  name: timezone
                  key: timezone
            - name: OTEL_TRACES_EXPORTER
              valueFrom:
                secretKeyRef:
                  name: configs
                  key: OTEL_TRACES_EXPORTER
            - name: OTEL_EXPORTER_JAEGER_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: configs
                  key: OTEL_EXPORTER_JAEGER_HTTP_ENDPOINT
          volumeMounts:
{% include 'partials/de_ca_volume_mount.j2' %}
            - name: event-recorder-configs
              mountPath: /etc/iplant/de
              readOnly: true
