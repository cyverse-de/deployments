apiVersion: apps/v1
kind: Deployment
metadata:
  name: data-info
spec:
  replicas: {{ data_info_replicas }}
  selector:
    matchLabels:
      de-app: data-info
  strategy:
    rollingUpdate:
      maxSurge: 200%
  template:
    metadata:
      labels:
        de-app: data-info
    spec:
{% if data_info_pod_anti_affinity %}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: de-app
                    operator: In
                    values:
                      - data-info
              topologyKey: kubernetes.io/hostname
{% endif %}
      restartPolicy: Always
      volumes:
{% include 'partials/de_ca_volume.j2' %}
{% include 'partials/de_ca_jvm_volume.j2' %}
        - name: data-info-configs
          secret:
            secretName: data-info-configs
            items:
              - key: data-info.properties
                path: data-info.properties
{% include 'partials/de_ca_jvm_init_container.j2' %}
      containers:
        - name: data-info
          image: harbor.cyverse.org/de/data-info
          resources:
            requests:
              cpu: "160m"
              memory: "1Gi"
              ephemeral-storage: "1Gi"
            limits:
              cpu: "4000m"
              memory: "3Gi"
              ephemeral-storage: "1Gi"
          args:
            - --config
            - /etc/iplant/de/data-info.properties
          volumeMounts:
{% include 'partials/de_ca_volume_mount.j2' %}
{% include 'partials/de_ca_jvm_volume_mount.j2' %}
            - name: data-info-configs
              mountPath: /etc/iplant/de
              readOnly: true
          env:
{% include 'partials/de_ca_env.j2' %}
            - name: TZ
              valueFrom:
                configMapKeyRef:
                  name: timezone
                  key: timezone
            - name: JAVA_TOOL_OPTIONS
              valueFrom:
                configMapKeyRef:
                  name: java-tool-options
                  key: high
            - name: OTEL_TRACES_EXPORTER
              valueFrom:
                secretKeyRef:
                  name: configs
                  key: OTEL_TRACES_EXPORTER
            - name: OTEL_EXPORTER_JAEGER_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: configs
                  key: OTEL_EXPORTER_JAEGER_ENDPOINT
          ports:
            - name: listen-port
              containerPort: 60000
          # The startup probe gates the other two, so they need no delay of their own. Unlike the
          # other services, GET / here opens an iRODS connection on every call, so only the startup
          # probe polls quickly: it stops once it succeeds, costing a couple of extra checks at boot.
          # The liveness and readiness periods stay at 20s to leave the steady-state load on iRODS
          # exactly as it was.
          livenessProbe:
            httpGet:
              path: /
              port: 60000
            periodSeconds: 20
            timeoutSeconds: 10
          startupProbe:
            httpGet:
              path: /
              port: 60000
            periodSeconds: 3
            timeoutSeconds: 10
            failureThreshold: 100
          readinessProbe:
            httpGet:
              path: /
              port: 60000
            periodSeconds: 20
            timeoutSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: data-info
spec:
  selector:
    de-app: data-info
  ports:
    - protocol: TCP
      port: 80
      targetPort: listen-port
