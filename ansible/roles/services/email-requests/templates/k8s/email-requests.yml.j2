apiVersion: apps/v1
kind: Deployment
metadata:
  name: email-requests
spec:
  replicas: {{ email_requests_replicas }}
  selector:
    matchLabels:
      de-app: email-requests
  template:
    metadata:
      labels:
        de-app: email-requests
    spec:
      restartPolicy: Always
      volumes:
{% if de_ca_bundle_configmap | default('', true) | length > 0 %}
        - name: de-ca
          configMap:
            name: {{ de_ca_bundle_configmap }}
{% endif %}
        - name: email-requests-configs
          secret:
            secretName: email-requests-configs
            items:
              - key: jobservices.yml
                path: jobservices.yml
      containers:
        - name: email-requests
          image: harbor.cyverse.org/de/email-requests
          resources:
            requests:
              cpu: "1m"
              memory: "128Mi"
              ephemeral-storage: "1Gi"
            limits:
              cpu: "100m"
              memory: "256Mi"
              ephemeral-storage: "1Gi"
          env:
{% if de_ca_bundle_configmap | default('', true) | length > 0 %}
            # One variable per runtime, because each ignores the others':
            # SSL_CERT_FILE is OpenSSL and so covers Go, Node reads only
            # NODE_EXTRA_CA_CERTS, and python-requests only REQUESTS_CA_BUNDLE.
            - name: SSL_CERT_FILE
              value: {{ de_ca_bundle_mount_path }}/{{ de_ca_bundle_key }}
            - name: NODE_EXTRA_CA_CERTS
              value: {{ de_ca_bundle_mount_path }}/{{ de_ca_bundle_key }}
            - name: REQUESTS_CA_BUNDLE
              value: {{ de_ca_bundle_mount_path }}/{{ de_ca_bundle_key }}
{% endif %}
            - name: TZ
              valueFrom:
                configMapKeyRef:
                  name: timezone
                  key: timezone
            - name: OTEL_TRACES_EXPORTER
              valueFrom:
                secretKeyRef:
                  name: configs
                  key: OTEL_TRACES_EXPORTER
            - name: OTEL_EXPORTER_JAEGER_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: configs
                  key: OTEL_EXPORTER_JAEGER_HTTP_ENDPOINT
          args:
            - --config
            - /etc/iplant/de/jobservices.yml
          volumeMounts:
{% if de_ca_bundle_configmap | default('', true) | length > 0 %}
            - name: de-ca
              mountPath: {{ de_ca_bundle_mount_path }}
              readOnly: true
{% endif %}
            - name: email-requests-configs
              mountPath: /etc/iplant/de
              readOnly: true
