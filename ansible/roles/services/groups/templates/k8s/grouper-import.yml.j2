# The Grouper importer, as a suspended CronJob.
#
# It is created suspended deliberately, and the cutover keeps it that way. The
# whole migration ships in one maintenance window, so nothing reads the imported
# rows before the window, and grouper_cutover.yml's preflight refuses to flip the
# data source marker while this CronJob is unsuspended -- past the flip every
# scheduled run refuses and exits nonzero, which reads as a failing service.
#
# The one case that resumes it is the rollback where permissions keeps its new
# image while the rest of the DE runs against Grouper, so group changes made
# through the Grouper-backed services still reach the permissions schema:
#
#     kubectl -n {{ ns }} patch cronjob grouper-import -p '{"spec":{"suspend":false}}'
#
# Unlike the groups service, this carries no de_ca_* partials on purpose: the
# importer reaches Grouper and the DE database over postgresql with sslmode
# disabled and the permissions service over plain HTTP, so it makes no TLS
# connection that a private CA would need to verify.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: grouper-import
spec:
  schedule: "{{ grouper_import_schedule }}"
  suspend: {{ grouper_import_suspended | bool | lower }}
  # The importer takes an advisory lock, so an overrun would block rather than
  # corrupt -- but skipping is the honest behaviour for a job that reconciles to
  # the current state anyway.
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 5
  jobTemplate:
    spec:
      backoffLimit: 2
      template:
        spec:
          restartPolicy: Never
          containers:
            - name: grouper-import
              image: {{ grouper_import_image }}
              command:
                - grouper-import
              envFrom:
                - secretRef:
                    name: grouper-import-configs
              resources:
                requests:
                  cpu: "100m"
                  memory: "256Mi"
                  ephemeral-storage: "1Gi"
                limits:
                  cpu: "1"
                  memory: "1Gi"
                  ephemeral-storage: "1Gi"
              env:
                - name: TZ
                  valueFrom:
                    configMapKeyRef:
                      name: timezone
                      key: timezone
