apiVersion: apps/v1
kind: Deployment
metadata:
  name: timelord
spec:
  replicas: {{ timelord_replicas }}
  selector:
    matchLabels:
      de-app: timelord
  template:
    metadata:
      labels:
        de-app: timelord
        app: de
    spec:
      serviceAccountName: app-exposer
{% if timelord_pod_anti_affinity %}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: de-app
                    operator: In
                    values:
                      - timelord
              topologyKey: kubernetes.io/hostname
{% endif %}
      restartPolicy: Always
      volumes:
{% if de_ca_bundle_configmap | default('', true) | length > 0 %}
        - name: de-ca
          configMap:
            name: {{ de_ca_bundle_configmap }}
{% endif %}
        - name: timelord-configs
          secret:
            secretName: timelord-configs
            items:
              - key: jobservices.yml
                path: jobservices.yml
      containers:
        - name: timelord
          image: harbor.cyverse.org/de/timelord
          env:
{% if de_ca_bundle_configmap | default('', true) | length > 0 %}
            - name: SSL_CERT_FILE
              value: {{ de_ca_bundle_mount_path }}/{{ de_ca_bundle_key }}
{% endif %}
            - name: TZ
              valueFrom:
                configMapKeyRef:
                  name: timezone
                  key: timezone
            - name: CLUSTER
              value: "1"
            - name: OTEL_TRACES_EXPORTER
              valueFrom:
                secretKeyRef:
                  name: configs
                  key: OTEL_TRACES_EXPORTER
            - name: OTEL_EXPORTER_JAEGER_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: configs
                  key: OTEL_EXPORTER_JAEGER_HTTP_ENDPOINT
          volumeMounts:
{% if de_ca_bundle_configmap | default('', true) | length > 0 %}
            - name: de-ca
              mountPath: {{ de_ca_bundle_mount_path }}
              readOnly: true
{% endif %}
            - name: timelord-configs
              mountPath: /etc/iplant/de
              readOnly: true
          resources:
            requests:
              cpu: "1m"
              memory: "128Mi"
              ephemeral-storage: "1Gi"
            limits:
              cpu: "100m"
              memory: "256Mi"
              ephemeral-storage: "1Gi"
          ports:
            - name: listen-port
              containerPort: 60000
          livenessProbe:
            httpGet:
              path: /debug/vars
              port: 60000
            initialDelaySeconds: 5
            periodSeconds: 5
          readinessProbe:
            httpGet:
              path: /debug/vars
              port: 60000
            initialDelaySeconds: 5
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: timelord
spec:
  selector:
    de-app: timelord
  ports:
    - protocol: TCP
      port: 80
      targetPort: listen-port
