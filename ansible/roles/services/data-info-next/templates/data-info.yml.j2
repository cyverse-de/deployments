{#-
  The Go rewrite's configuration, translated from data-info.properties.j2. The two are kept
  in step by hand until cutover, at which point this file replaces that one under the
  data-info role and this role goes away.

  Every value is emitted through to_json rather than written bare: passwords, the AMQP URI
  and the bad-chars string all contain characters that YAML would otherwise read as syntax,
  and JSON scalars are valid YAML.
-#}
port: 60000

timeouts:
  # The Clojure service gave the two upload routes a 3600s Jetty idle timeout against a 200s
  # default; these are the same two numbers.
  request: 200s
  upload: 3600s

permsfilter: {{ irods_perms_filter | to_json }}
communitydata: {{ ("/" ~ irods_zone ~ "/home/shared") | to_json }}
# U+0060 GRAVE ACCENT, U+0027 APOSTROPHE, U+000A LINE FEED, U+0009 CHARACTER TABULATION.
badchars: "`'\n\t"
maxpaths: 1000
anonuser: anonymous

anonfiles:
{% if irods_webdav_anon_uri %}
  baseurl: {{ irods_webdav_anon_uri | to_json }}
  # A real mapping rather than the JSON-inside-a-properties-value the Clojure service took.
  # Longest matching prefix wins, so the order here does not matter.
  mappings:
    {{ ("/" ~ irods_zone ~ "/home/shared/") | to_json }}: {{ (irods_zone ~ "/projects/") | to_json }}
    {{ ("/" ~ irods_zone ~ "/home/shared/commons_repo/curated/") | to_json }}: {{ (irods_zone ~ "/commons/cyverse_curated/") | to_json }}
    {{ ("/" ~ irods_zone ~ "/home/") | to_json }}: {{ (irods_zone ~ "/home/") | to_json }}
{% else %}
  baseurl: {{ (de_base_uri | string | regex_replace("\/$", "") ~ "/anon-files") | to_json }}
  mappings:
    {{ ("/" ~ irods_zone ~ "/") | to_json }}: {{ (irods_zone ~ "/") | to_json }}
{% endif %}

kifshare:
  externalurl: {{ (de_base_uri | string | regex_replace("\/$", "") ~ "/dl") | to_json }}
  # Mustache, and the braces are literal -- unlike the properties file, nothing here needs
  # them escaped.
  downloadtemplate: "{{ '{{url}}/d/{{ticket-id}}/{{filename}}' }}"

services:
  asynctasks: {{ baseurls_async_tasks | string | regex_replace("\/$", "") | to_json }}
  metadata: {{ baseurls_metadata | string | regex_replace("\/$", "") | to_json }}
  notificationagent: {{ baseurls_notifications | string | regex_replace("\/$", "") | to_json }}

irods:
  host: {{ irods_host | to_json }}
  port: 1247
  zone: {{ irods_zone | to_json }}
  user: {{ irods_user | to_json }}
  password: {{ irods_password | to_json }}
  home: {{ ("/" ~ irods_zone ~ "/home") | to_json }}
  resource: ""
  maxretries: 10
  retrysleep: 1s
  usetrash: true
  adminusers: {{ irods_admin_users | to_json }}
  # maxsessions x maxconnections is the ceiling on iRODS agents one replica can occupy, so
  # these are the numbers to check against the server's agent limit before scaling up.
  maxsessions: 32
  maxconnections: 4
  sessionidletimeout: 5m
  # Socket deadlines, not politeness. They bound how long a call whose caller has already
  # given up can keep holding a connection; listings and bulk reads run under the long one.
  operationtimeout: 1m
  longoperationtimeout: 5m

icat:
  host: {{ icat_host | to_json }}
  port: {{ icat_port }}
  user: {{ icat_user | to_json }}
  password: {{ icat_password | to_json }}
  database: ICAT
  sslmode: disable

typedetect:
  # Read and written here; the detection behind it belongs to info-typer.
  attribute: ipc-filetype

pathlists:
  ht:
    identifier: "# application/vnd.de.path-list+csv; version=1"
    infotype: ht-analysis-path-list
  multiinput:
    identifier: "# application/vnd.de.multi-input-path-list+csv; version=1"
    infotype: multi-input-path-list

# No dataone block: data-info.properties.j2 sets none of those properties either, so both
# services run on the same built-in defaults -- including the member-node base, which points
# at the production DataONE node from every environment.

amqp:
  # urlencode leaves / alone, so both the password and the vhost get it replaced by hand.
  # data-info.properties.j2 does that for the vhost only, which is a latent break there: a
  # password containing a slash yields a URI whose authority parses as a bad port. The Go
  # service refuses to start on one rather than failing later at connect time.
  uri: {{ ("amqp://" ~ de_amqp_user ~ ":" ~ (de_amqp_password | urlencode | regex_replace('/', '%2F')) ~ "@" ~ de_amqp_host ~ ":" ~ de_amqp_port ~ "/" ~ (de_amqp_vhost | urlencode | regex_replace('/', '%2F'))) | to_json }}
  exchange:
    # Hardcoded, as it is in every other service's template that names this exchange.
    name: de
    durable: true
    autodelete: false
